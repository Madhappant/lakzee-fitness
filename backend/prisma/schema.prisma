// Prisma Schema — Lakzee Fitness Studio
// Organized by domain: Multi-Branch | Identity & Auth | Members & Plans | Catalog & Ledger | Attendance & Audit | Studio & Leads

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 0. MULTI-BRANCH TENANCY ROOT
// ============================================================================

model Branch {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  location  String
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  memberProfiles  MemberProfile[]
  membershipPlans MembershipPlan[]
  subscriptions   Subscription[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  attendances     Attendance[]
  announcements   Announcement[]
  auditLogs        AuditLog[]
  settings         Settings[]
  inquiries        ConsultationInquiry[]
  notificationLogs NotificationLog[]

  @@index([status, createdAt])
}

// ============================================================================
// 1. IDENTITY, AUTHENTICATION & STAFF ROLES
// ============================================================================

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  role           String    @default("MEMBER") // SUPER_ADMIN, BRANCH_ADMIN, ADMIN, RECEPTIONIST, TRAINER, STAFF, MEMBER
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  firstName      String
  lastName       String
  phone          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  roleAssignedAt DateTime?

  resetOtp       String?
  resetOtpExpiry DateTime?

  pendingPhone   String?
  phoneOtp       String?
  phoneOtpExpiry DateTime?

  memberProfile   MemberProfile?
  staffProfile    StaffProfile?
  assignedMembers MemberProfile[]  @relation("TrainerToMember")
  announcements   Announcement[]
  refreshSessions RefreshSession[]

  @@index([role])
  @@index([phone])
  @@index([createdAt])
  @@index([role, createdAt])
  @@index([branchId, role])
  @@index([branchId, createdAt])
  @@index([branchId, role, createdAt])
}

model RefreshSession {
  id           String    @id
  familyId     String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model StaffProfile {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation    String?
  shiftStart     String? // HH:mm
  shiftEnd       String? // HH:mm
  specialization String? // For trainers
}

// ============================================================================
// 2. MEMBER PROFILES & TRAINING ROUTINES
// ============================================================================

model MemberProfile {
  id                String   @id @default(uuid())
  branchId          String?
  branch            Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberId          String   // Sequential per branch (e.g., 001, 002)
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  photoUrl             String?
  whatsapp             String?
  whatsappNumber       String?  // E.164 format e.g. +919876543210
  notificationsEnabled Boolean  @default(true)
  dob                  DateTime?
  gender            String? // MALE, FEMALE, OTHER
  height            Float?  // in cm
  weight            Float?  // in kg
  bloodGroup        String?
  occupation        String?
  emergencyContact  String?
  medicalConditions String?
  address           String?
  joiningDate       DateTime @default(now())
  createdAt         DateTime @default(now())
  lockerNumber      String?
  notes             String?
  idProofUrl        String?
  qrCode            String   @unique @default(uuid()) // Unique QR token for attendance scans

  trainerId         String?
  trainer           User?    @relation("TrainerToMember", fields: [trainerId], references: [id], onDelete: SetNull)

  subscriptions     Subscription[]
  attendances       Attendance[]
  invoices          Invoice[]
  payments          Payment[]
  dietPlans         DietPlan[]
  workoutRoutines   WorkoutRoutine[]
  notificationLogs  NotificationLog[]

  @@unique([branchId, memberId])
  @@index([branchId, memberId])
  @@index([branchId, createdAt])
  @@index([branchId, joiningDate])
  @@index([trainerId])
  @@index([joiningDate])
  @@index([dob])
}

model DietPlan {
  id         String        @id @default(uuid())
  memberId   String
  member     MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedBy String?       // ID of trainer/admin who assigned it
  title      String        @default("Personalized Diet Plan")
  notes      String?       // General guidelines
  mealsData  String        // JSON string of meals
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([memberId, isActive])
  @@index([assignedBy])
}

model WorkoutRoutine {
  id            String        @id @default(uuid())
  memberId      String
  member        MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedBy    String?       // ID of trainer/admin who assigned it
  title         String        @default("Personalized Workout Routine")
  notes         String?       // General guidelines
  exercisesData String        // JSON string of days/exercises
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([memberId, isActive])
  @@index([assignedBy])
}

// ============================================================================
// 3. CATALOG, SUBSCRIPTIONS & FINANCIAL LEDGER
// ============================================================================

model MembershipPlan {
  id               String         @id @default(uuid())
  branchId         String?
  branch           Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name             String         // e.g., "Premium Annual", "Student Monthly"
  description      String?
  price            Float
  priceInPaise     Int?
  durationDays     Int
  gstPercentage    Float          @default(18.0)
  taxPercent       Float?
  freezeDays       Int            @default(0)
  personalTraining Boolean        @default(false)
  dietIncluded     Boolean        @default(false)
  lockerIncluded   Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  subscriptions    Subscription[]
  payments         Payment[]

  @@index([isActive])
  @@index([branchId, isActive])
  @@index([branchId, createdAt])
}

model Subscription {
  id             String         @id @default(uuid())
  branchId       String?
  branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberId       String
  member         MemberProfile  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId         String
  plan           MembershipPlan @relation(fields: [planId], references: [id])
  startDate      DateTime
  endDate        DateTime
  status         String         @default("ACTIVE") // ACTIVE, EXPIRED, FROZEN, CANCELLED
  paymentStatus  String         @default("PAID")   // PAID, PENDING
  paymentMethod  String         @default("CASH")   // CASH, UPI, CREDIT_CARD, BANK_TRANSFER
  balanceAmount  Float          @default(0)
  frozenDaysUsed Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoice        Invoice?

  @@index([memberId])
  @@index([planId])
  @@index([status, endDate])
  @@index([endDate, status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([createdAt, paymentStatus])
  @@index([branchId, status, endDate])
  @@index([branchId, createdAt])
  @@index([branchId, paymentStatus])
}

model Invoice {
  id             String        @id @default(uuid())
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoiceNumber  String        @unique
  memberId       String
  member         MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  subtotal       Float
  discount       Float         @default(0)
  gstAmount      Float
  totalAmount    Float

  status         String        @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  createdAt      DateTime      @default(now())

  payments       Payment[]

  @@index([memberId])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt, status])
  @@index([branchId, createdAt])
  @@index([branchId, status])
}

model Payment {
  id                 String          @id @default(uuid())
  branchId           String?
  branch             Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoiceId          String?
  invoice            Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  memberId           String?
  member             MemberProfile?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  planId             String?
  plan               MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount             Float
  amountInPaise      Int?
  currency           String          @default("INR")
  method             String          // CASH, UPI, CREDIT_CARD, DEBIT_CARD, BANK_TRANSFER, SPLIT, upi, card, netbanking
  transactionId      String?
  razorpayOrderId    String?         @unique
  razorpayPaymentId  String?         @unique
  razorpaySignature  String?
  invoiceNumber      String?         @unique
  receiptUrl         String?
  previousExpiryDate DateTime?
  newExpiryDate      DateTime?
  status             String          @default("COMPLETED") // COMPLETED, CREATED, CAPTURED, FAILED, REFUNDED
  paymentDate        DateTime        @default(now())
  paidAt             DateTime?
  failureReason      String?
  notes              String?

  @@index([invoiceId])
  @@index([memberId, paymentDate])
  @@index([planId])
  @@index([paymentDate])
  @@index([status, paymentDate])
  @@index([branchId, paymentDate])
  @@index([branchId, status, paymentDate])
  @@index([branchId, method, status])
}

model Expense {
  id            String   @id @default(uuid())
  branchId      String?
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  title         String
  category      String   // SALARY, MAINTENANCE, RENT, WATER, ELECTRICITY, CLEANING, OTHER
  amount        Float
  date          DateTime @default(now())
  paymentMethod String   @default("CASH") // CASH, UPI, BANK_TRANSFER, CREDIT_CARD
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
  @@index([category])
  @@index([branchId, date])
  @@index([branchId, createdAt])
}

// ============================================================================
// 4. ATTENDANCE & ACTIVITY LOGS
// ============================================================================

model Attendance {
  id       String        @id @default(uuid())
  branchId String?
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberId String
  member   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  checkIn  DateTime      @default(now())
  checkOut DateTime?
  date     DateTime

  @@index([date])
  @@index([date, checkIn(sort: Desc)])
  @@index([memberId, checkOut])
  @@index([memberId, checkIn])
  @@index([branchId, date, checkIn(sort: Desc)])
  @@index([branchId, checkIn])
}

model AuditLog {
  id          String   @id @default(uuid())
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId      String?
  actorId     String?
  actorRole   String?
  action      String
  targetId    String?
  ipAddress   String?
  description String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([action, createdAt])
  @@index([createdAt])
  @@index([branchId, createdAt])
  @@index([branchId, action, createdAt])
}

// ============================================================================
// 5. STUDIO CONFIGURATION, ANNOUNCEMENTS & LEAD PIPELINE
// ============================================================================

model Settings {
  id                       String  @id @default("1")
  branchId                 String? @unique
  branchRef                Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  gymName                  String  @default("Lakzee Fitness Studio")
  logoUrl                  String?
  branch                   String?
  workingHours             String?
  gstNumber                String?
  address                  String?
  contactEmail             String?
  contactPhone             String?
  whatsappRemindersEnabled Boolean @default(true)
  emailRemindersEnabled    Boolean @default(true)
  reminderMilestones       String  @default("7,3,1,0") // Comma-separated active days before expiry (7,3,1,0=Expired)
}

model NotificationLog {
  id                String        @id @default(uuid())
  branchId          String?
  branch            Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberId          String
  member            MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  channel           String        // WHATSAPP, EMAIL
  milestone         String        // 7_DAYS, 3_DAYS, 1_DAY, EXPIRED
  cycleExpiryDate   DateTime      // Normalized UTC midnight date of the subscription endDate
  status            String        // SENT, FAILED, SKIPPED
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime      @default(now())

  @@unique([memberId, channel, milestone, cycleExpiryDate])
  @@index([branchId, sentAt(sort: Desc)])
  @@index([branchId, status, sentAt(sort: Desc)])
  @@index([memberId, sentAt(sort: Desc)])
}

model Announcement {
  id        String   @id @default(uuid())
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  title     String
  message   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([branchId, createdAt])
}

model ConsultationInquiry {
  id        String   @id @default(uuid())
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  email     String?
  goal      String
  message   String?
  status    String   @default("NEW") // NEW, CONTACTED, CONVERTED, CLOSED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@index([branchId, status, createdAt])
}
