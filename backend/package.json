{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "build:prod": "prisma generate && tsc -p tsconfig.prod.json",
    "start": "npx prisma db push && npx prisma db seed && node dist/server.js",
    "start:prod": "node dist/server.js",
    "db:deploy": "npx prisma db push --skip-generate --accept-data-loss=false",
    "db:migrate:branches": "tsx scripts/migrate-multi-branch.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:baseline": "tsx --test tests/*.test.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run tests/unit tests/integration --coverage",
    "test": "npm run test:baseline && npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "",
