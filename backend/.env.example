# Server & Environment
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Supabase / Neon) & Connection Pooling
DATABASE_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/dbname
PRISMA_CONNECTION_LIMIT=15
PRISMA_POOL_TIMEOUT=15

# Distributed Redis Cache & Shared Rate Limiting (Optional — automatic in-memory fallback when empty)
# Supports either Upstash REST or standard redis:// / rediss:// TCP URL
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# JWT & Session Security (Required — use 64+ char cryptographically random secrets in production)
JWT_SECRET=replace-with-64-char-random-secret
JWT_REFRESH_SECRET=replace-with-distinct-64-char-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Trusted Frontend Origins (comma-separated in production, no wildcards)
CLIENT_URL=http://localhost:3000

# Email OTP / Notifications
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=
OPENROUTER_API_KEY=

# Production Observability, Error Tracking & Alerting
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SLOW_QUERY_THRESHOLD_MS=200
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_MS=300000

# Automated Encrypted Database Backups (AES-256-GCM + Cloudflare R2 / AWS S3 / Backblaze B2)
BACKUP_ENCRYPTION_KEY=
BACKUP_LOCAL_DIR=backups
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=lakzee-backups

# Automated WhatsApp & Email Expiry Reminders
DRY_RUN=false
REMINDER_CRON_ENABLED=true
REMINDER_TIMEZONE=Asia/Kolkata
REMINDER_CRON_HOUR=9
REMINDER_CRON_MINUTE=0
CRON_SECRET=replace-with-random-cron-webhook-secret

# WhatsApp Provider (Meta WhatsApp Cloud API default, or WHATSAPP_PROVIDER=webhook for Twilio/Evolution API)
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=membership_expiry_reminder
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# Email Provider (Resend REST API or Nodemailer SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Lakzee Fitness Studio <notifications@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Online Payments & Razorpay (UPI, GPay, PhonePe, Paytm, Card, NetBanking)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK_MODE=false
