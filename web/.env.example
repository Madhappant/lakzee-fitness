# Backend API Base URL (must point to HTTPS API `/api` in production)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Canonical Frontend URL used for OpenGraph & SEO metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Browser Sentry / GlitchTip DSN (no secrets — public ingest DSN only)
NEXT_PUBLIC_SENTRY_DSN=
