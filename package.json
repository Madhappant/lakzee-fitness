{
  "name": "lakzee-fitness",
  "version": "1.0.0",
  "private": true,
  "description": "Lakzee Fitness Studio - Full-Stack Gym Management System",
  "scripts": {
    "test:unit": "npm --prefix backend run test:unit",
    "test:integration": "npm --prefix backend run test:integration",
    "test:coverage": "npm --prefix backend run test:coverage",
    "test:backend": "npm --prefix backend run test",
    "test:e2e": "npm --prefix web run test:e2e",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "db:migrate:branches": "npm --prefix backend run db:migrate:branches",
    "db:backup": "node scripts/backup-db.mjs",
    "db:restore": "node scripts/restore-db.mjs"
  }
}
